---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { legal } from '../data/site';
---

<Base title="Términos y condiciones — Daewoo Perú">
  <Header />
  <main class="wrap">
    <div class="container">
      <h1>Términos y condiciones</h1>
      <p>{legal.terms}</p>
      <p class="tbd">
        Contenido pendiente de entrega por el área legal de Space Brands. Reemplazar este bloque con
        el documento definitivo.
      </p>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .wrap { padding-block: clamp(3rem, 8vw, 5rem); }
  h1 { font-size: var(--fs-h1); margin-bottom: 1.5rem; }
  p { max-width: 70ch; margin-bottom: 1rem; color: var(--c-ink); }
  .tbd { color: var(--c-blue); font-weight: 600; }
</style>
