---
import { getImage } from 'astro:assets';
import { Image } from 'astro:assets';
import daewooSpace from '../assets/logos/daewoo-space.png';
import badge from '../assets/logos/50-years-daewoo.png';
import artMobile from '../assets/footer-art.png';
import artDesktop from '../assets/footer-art-wide.png';
import { social, legal } from '../data/site';

const artMobileOpt = await getImage({ src: artMobile, width: 640, format: 'png' });
const artDesktopOpt = await getImage({ src: artDesktop, width: 1920, format: 'png' });
import { withBase } from '../lib/url';

const icons: Record<string, string> = {
  linkedin:
    '<path d="M4.98 3.5A2.5 2.5 0 1 1 0 3.5a2.5 2.5 0 0 1 4.98 0ZM.24 8.25h4.5V24h-4.5V8.25ZM8.5 8.25h4.31v2.15h.06c.6-1.13 2.06-2.32 4.24-2.32 4.54 0 5.38 2.99 5.38 6.88V24h-4.5v-6.98c0-1.66-.03-3.8-2.32-3.8-2.32 0-2.67 1.81-2.67 3.68V24H8.5V8.25Z"/>',
  instagram:
    '<path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 3.68a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32Zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm7.85-10.4a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0Z"/>',
  facebook:
    '<path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.89v2.26h3.32l-.53 3.49h-2.79V24C19.61 23.1 24 18.1 24 12.07Z"/>',
};
---

<footer class="footer">
  <div class="container">
    <div class="top" data-reveal>
      <picture class="footer-art">
        <source media="(min-width: 721px)" srcset={artDesktopOpt.src} />
        <img src={artMobileOpt.src} alt="" aria-hidden="true" />
      </picture>
      <Image class="brand-logo" src={daewooSpace} alt="Daewoo Space" width={194} height={30} />
      <div class="blurb">
        <p>
          Nos apasiona ofrecer experiencias de visualización innovadoras que te acercan a las
          historias que amas, con imágenes vibrantes, funciones inteligentes y diseños modernos.
        </p>
        <Image class="badge" src={badge} alt="50 años Daewoo" width={167} height={67} />
      </div>
    </div>

    <div class="meta">
      <p class="copy">{legal.copyright}</p>
      <div class="social">
        <span>Síguenos en:</span>
        <ul>
          {social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={icons[s.icon]} />
              </a>
            </li>
          ))}
        </ul>
      </div>
      <a class="terms" href={withBase('terminos')}>Términos y condiciones</a>
    </div>

    <p class="legal">{legal.terms}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    color: var(--c-white);
    padding-block: clamp(2.5rem, 7vw, 4.5rem);
    overflow: hidden;
    background-color: #0d0d0d;
  }
  /* footer content (and the divider lines) run the full width, just the section padding */
  .footer :global(.container) {
    max-width: none;
  }
  .footer::after {
    /* keep the copy legible on the left */
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #0d0d0d 34%, rgba(13, 13, 13, 0.55) 62%, rgba(13, 13, 13, 0) 100%);
    z-index: -1;
    pointer-events: none;
  }

  .top {
    position: relative;
    min-height: clamp(230px, 21vw, 460px);
    padding-bottom: clamp(1.25rem, 3vw, 2rem);
  }
  /* appliance render: its BOTTOM edge (reflection) sits right on the divider line.
     Desktop uses a full-width band (art-directed crop) so it spans the whole
     footer; mobile keeps a tighter, smaller crop anchored to the right. */
  .footer-art {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: -2;
    width: 82%;
    pointer-events: none;
  }
  .footer-art img {
    display: block;
    width: 100%;
    height: auto;
    opacity: 0.55;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 22%);
    mask-image: linear-gradient(90deg, transparent, #000 22%);
  }

  @media (min-width: 721px) {
    .footer-art {
      left: 0;
      width: auto;
    }
    .footer-art img {
      opacity: 1;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  @media (max-width: 720px) {
    .top {
      min-height: 0;
      padding-bottom: 9rem;
    }
  }
  .brand-logo {
    height: 30px;
    width: auto;
    margin-bottom: 1rem;
  }
  .blurb {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    max-width: 480px;
  }
  .blurb p {
    flex: 1;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--c-grey-light);
    text-align: justify;
  }
  .badge {
    flex: none;
    height: 62px;
    width: auto;
  }
  @media (max-width: 560px) {
    .blurb {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2.5rem;
    padding-block: 1.35rem;
    border-top: 1px solid #4a4a4a;
    border-bottom: 1px solid #4a4a4a;
    font-size: 0.75rem;
    color: var(--c-grey-light);
  }
  .copy { max-width: 42ch; }
  .social { display: flex; align-items: center; gap: 0.75rem; }
  .social ul { display: flex; gap: 0.9rem; list-style: none; padding: 0; margin: 0; }
  .social a {
    display: grid;
    place-items: center;
    color: var(--c-grey-light);
    transition: color 0.15s var(--ease), transform 0.15s var(--ease);
  }
  .social a:hover { color: var(--c-white); transform: translateY(-2px); }
  .social svg { width: 17px; height: 17px; }
  .terms { color: var(--c-grey-light); text-decoration: none; white-space: nowrap; }
  .terms:hover { color: var(--c-white); text-decoration: underline; }

  .legal {
    margin-top: 1.6rem;
    font-size: 0.6875rem;
    line-height: 1.55;
    color: var(--c-grey);
  }

  @media (max-width: 720px) {
    .meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>
