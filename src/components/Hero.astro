---
import { Image, getImage } from 'astro:assets';
import posterImg from '../assets/hero-poster.png';
import { withBase } from '../lib/url';

// optimized poster for the <video poster> attribute (the visible <Image> is optimized separately)
const posterWebp = await getImage({ src: posterImg, width: 1280, format: 'webp' });
---

<section class="hero" id="inicio" aria-label="Presentación Daewoo">
  <div class="stage">
    <Image
      class="poster"
      src={posterImg}
      alt="Nueva línea Daewoo NeoXVision con Google TV"
      widths={[480, 768, 1280, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />

    <video
      class="video"
      autoplay
      muted
      loop
      playsinline
      disablepictureinpicture
      preload="none"
      poster={posterWebp.src}
    >
      <source data-src={withBase('video/hero.webm')} type="video/webm" />
      <source data-src={withBase('video/hero.mp4')} type="video/mp4" />
    </video>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('.hero')!;
  const video = hero.querySelector<HTMLVideoElement>('.video')!;
  const conn = (navigator as any).connection;
  const saveData = conn?.saveData === true;
  const slow = conn && /(^|-)2g$/.test(conn.effectiveType || '');

  let done = false;
  const loadVideo = () => {
    if (done) return;
    done = true;
    video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((s) => {
      s.src = s.dataset.src!;
    });
    video.load();
    video.play().then(() => hero.classList.add('is-playing')).catch(() => {});
  };

  video.addEventListener('playing', () => hero.classList.add('is-playing'));

  // Don't autoload heavy video on data-saver / very slow links — poster stays.
  if (!saveData && !slow) {
    const kick = () => {
      const start = () =>
        'requestIdleCallback' in window
          ? (window as any).requestIdleCallback(loadVideo, { timeout: 2500 })
          : setTimeout(loadVideo, 1200);
      // wait until the hero is on screen, then defer past first paint / LCP
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (e) => {
            if (e.some((x) => x.isIntersecting)) {
              io.disconnect();
              start();
            }
          },
          { rootMargin: '300px' },
        );
        io.observe(hero);
      } else {
        start();
      }
    };
    if (document.readyState === 'complete') kick();
    else window.addEventListener('load', kick, { once: true });
  }

  // last-resort: honour autoplay after the first user gesture
  ['pointerdown', 'keydown', 'touchstart'].forEach((ev) =>
    window.addEventListener(ev, () => (loadVideo(), video.play().catch(() => {})), {
      once: true,
      passive: true,
    }),
  );
</script>

<style>
  .hero {
    background: var(--c-black);
  }
  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 86vh;
    overflow: hidden;
  }
  @media (max-width: 640px) {
    .stage {
      aspect-ratio: 16 / 10;
    }
  }
  .poster,
  .video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .video {
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }
  .is-playing .video {
    opacity: 1;
  }
  .is-playing .poster {
    opacity: 0;
  }
</style>
