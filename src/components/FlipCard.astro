---
import { Image } from 'astro:assets';
import type { Category } from '../data/categories';

interface Props {
  category: Category;
  /** duplicated slides that fill the infinite loop (not exposed to a11y) */
  clone?: boolean;
}
const { category, clone = false } = Astro.props;
---

<article
  class="card"
  style={`--accent:${category.accent}`}
  aria-hidden={clone ? 'true' : undefined}
  tabindex={clone ? undefined : '0'}
  aria-label={clone ? undefined : `${category.name} — pulsa para ver el detalle`}
>
  <div class="inner">
    <div class="face front">
      <Image
        class="photo"
        src={category.image}
        alt={clone ? '' : category.name}
        widths={[345, 520, 690, 900]}
        sizes="(max-width: 640px) 80vw, 345px"
        loading="lazy"
      />
      <div class="front-body">
        <span class="icon" set:html={category.icon} />
        <h3>{category.frontTitle}</h3>
        <p>{category.frontText}</p>
      </div>
    </div>

    <div class="face back">
      <Image class="back-logo" src={category.backLogo} alt={clone ? '' : category.backTitle} height={22} densities={[1, 2]} loading="lazy" decoding="async" />
      <p class="back-desc">{category.backText}</p>
      <ul class="back-benefits" aria-hidden="true">
        {category.backBenefits.map((b) => (
          <li><Image src={b} alt="" height={22} densities={[1, 2]} loading="lazy" decoding="async" /></li>
        ))}
      </ul>
    </div>
  </div>
</article>

<style>
  .card {
    flex: 0 0 auto;
    width: min(82vw, 350px);
    aspect-ratio: 340 / 290;
    perspective: 1200px;
    cursor: pointer;
    border-radius: var(--radius-card);
  }
  .card:focus-visible {
    outline: 2px solid var(--c-blue-100);
    outline-offset: 4px;
  }

  .inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.55s var(--ease);
    transform-style: preserve-3d;
  }
  .card.is-flipped .inner {
    transform: rotateY(180deg);
  }
  @media (hover: hover) and (pointer: fine) {
    .card:not(.is-flipped):hover .inner {
      transform: rotateY(180deg);
    }
  }

  .face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  /* front */
  .front {
    background: var(--c-black);
  }
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .front::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grad-card-front);
  }
  .front-body {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 0.95rem 1rem;
    color: var(--c-white);
  }
  .icon {
    width: 30px;
    height: 30px;
    margin-bottom: 0.15rem;
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .front-body h3 {
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .front-body p {
    font-size: 0.625rem;
    font-weight: 300;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.82);
  }

  /* back — rebuilt in HTML at the proportions of the Figma art, but sharp */
  .back {
    transform: rotateY(180deg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 2vw, 0.8rem);
    padding: clamp(0.75rem, 3.5vw, 1rem);
    background: radial-gradient(130% 85% at 50% -5%, #1d1e22 0%, #0b0b0c 72%);
    color: #fff;
    text-align: center;
  }
  .back-logo {
    flex: none;
    height: clamp(16px, 4.5vw, 21px);
    width: auto;
  }
  .back-desc {
    flex: 0 1 auto;
    min-height: 0;
    overflow-y: auto;
    font-size: clamp(0.5rem, 0.42rem + 0.35vw, 0.625rem);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.94);
    text-wrap: pretty;
  }
  .back-desc::-webkit-scrollbar {
    width: 2px;
  }
  .back-desc::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.22);
  }
  .back-benefits {
    flex: none;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
    column-gap: clamp(0.3rem, 2vw, 0.7rem);
    row-gap: clamp(0.35rem, 1.5vw, 0.5rem);
    list-style: none;
    margin: 0;
    padding: clamp(0.45rem, 2vw, 0.75rem) 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .back-benefits li {
    display: flex;
    justify-content: center;
    min-width: 0;
  }
  .back-benefits :global(img) {
    max-width: 100%;
    max-height: clamp(19px, 5vw, 24px);
    width: auto;
    height: auto;
    object-fit: contain;
  }
</style>

<script>
  // Once any touch happens we treat this as a touch device, even if it also reports
  // (hover: hover) — some Android browsers and 2-in-1s do.
  let touchUsed = false;
  addEventListener('touchstart', () => (touchUsed = true), { once: true, passive: true, capture: true });
  const mouseOnly = () => !touchUsed && matchMedia('(hover: hover) and (pointer: fine)').matches;

  document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
    const real = !card.hasAttribute('aria-hidden');
    let flippedAt = 0;
    const flip = () => {
      card.classList.toggle('is-flipped');
      flippedAt = Date.now();
    };

    // mouse on a hover device: CSS :hover drives the flip; reset when the pointer leaves
    card.addEventListener('mouseleave', () => card.classList.remove('is-flipped'));

    // --- touch: tap flips, swipe doesn't ---
    let tx = 0,
      ty = 0;
    card.addEventListener(
      'touchstart',
      (e) => {
        tx = e.touches[0].clientX;
        ty = e.touches[0].clientY;
      },
      { passive: true },
    );
    card.addEventListener(
      'touchend',
      (e) => {
        const t = e.changedTouches[0];
        if (Math.hypot(t.clientX - tx, t.clientY - ty) > 14) return; // was a swipe
        e.preventDefault(); // stop the browser synthesising a click
        flip();
      },
      { passive: false },
    );

    // --- click: mouse-less activation (keyboard AT, screen readers) + fallback ---
    card.addEventListener('click', () => {
      if (mouseOnly()) return; // desktop mouse → hover already handled it
      if (Date.now() - flippedAt < 500) return; // touchend already handled it
      flip();
    });

    if (real) {
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          flip();
        }
      });
    }
  });
</script>
