---
import { Image } from 'astro:assets';
import type { Category } from '../data/categories';

interface Props {
  category: Category;
  /** duplicated slides used only to fill the infinite loop */
  clone?: boolean;
}
const { category, clone = false } = Astro.props;
---

<article
  class="card"
  style={`--accent:${category.accent}`}
  aria-hidden={clone ? 'true' : undefined}
  tabindex={clone ? undefined : '0'}
  aria-label={clone ? undefined : `${category.name} — pulsa para ver el detalle`}
>
  <div class="inner">
    <div class="face front">
      <Image
        class="photo"
        src={category.image}
        alt={clone ? '' : category.name}
        widths={[345, 520, 690, 900]}
        sizes="(max-width: 640px) 80vw, 345px"
        loading="lazy"
      />
      <div class="front-body">
        <span class="icon" set:html={category.icon} />
        <h3>{category.frontTitle}</h3>
        <p>{category.frontText}</p>
      </div>
    </div>

    {!clone && (
      <div class="face back">
        <Image class="back-logo" src={category.backLogo} alt={category.backTitle} height={26} densities={[1, 2]} loading="lazy" />
        <p class="back-desc">{category.backText}</p>
        <ul class="back-benefits" aria-hidden="true">
          {category.backBenefits.map((b) => (
            <li><Image src={b} alt="" height={34} densities={[1, 2]} loading="lazy" /></li>
          ))}
        </ul>
      </div>
    )}
  </div>
</article>

<style>
  .card {
    flex: 0 0 auto;
    width: min(80vw, 350px);
    aspect-ratio: 360 / 283;
    perspective: 1200px;
    cursor: pointer;
    border-radius: var(--radius-card);
  }
  .card:focus-visible {
    outline: 2px solid var(--c-blue-100);
    outline-offset: 4px;
  }

  .inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.55s var(--ease);
    transform-style: preserve-3d;
  }
  .card.is-flipped .inner {
    transform: rotateY(180deg);
  }
  /* laptop / mouse: flip on hover (clones have no back face, never flip) */
  @media (hover: hover) and (pointer: fine) {
    .card:not([aria-hidden]):not(.is-flipped):hover .inner {
      transform: rotateY(180deg);
    }
  }

  .face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  /* front */
  .front {
    background: var(--c-black);
  }
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .front::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grad-card-front);
  }
  .front-body {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 0.95rem 1rem;
    color: var(--c-white);
  }
  .icon {
    width: 30px;
    height: 30px;
    margin-bottom: 0.15rem;
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .front-body h3 {
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .front-body p {
    font-size: 0.625rem;
    font-weight: 300;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.82);
  }

  /* back — rebuilt in HTML so text and logos stay razor-sharp */
  .back {
    transform: rotateY(180deg);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 0.85rem 0.75rem;
    background: radial-gradient(120% 90% at 50% 0%, #17181b 0%, #0a0a0b 70%);
    color: var(--c-white);
  }
  .back-logo {
    flex: none;
    height: clamp(20px, 5vw, 26px);
    width: auto;
  }
  .back-desc {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    font-size: clamp(0.625rem, 0.55rem + 0.35vw, 0.75rem);
    line-height: 1.42;
    text-align: center;
    color: rgba(255, 255, 255, 0.9);
    text-wrap: pretty;
  }
  .back-desc::-webkit-scrollbar {
    width: 3px;
  }
  .back-desc::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.25);
    border-radius: 3px;
  }
  .back-benefits {
    flex: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
    justify-items: center;
    gap: 0.4rem 0.3rem;
    width: 100%;
    list-style: none;
    margin: 0;
    padding: 0.35rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .back-benefits li {
    display: flex;
    justify-content: center;
    width: 100%;
  }
  .back-benefits :global(img) {
    height: clamp(26px, 6.5vw, 34px);
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }
</style>

<script>
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;

  document.querySelectorAll<HTMLElement>('.card:not([aria-hidden])').forEach((card) => {
    const toggle = (state?: boolean) => {
      const next = state ?? !card.classList.contains('is-flipped');
      card.classList.toggle('is-flipped', next);
    };

    if (canHover) {
      // desktop: hover handles it; clear any lingering flip on leave
      card.addEventListener('mouseleave', () => toggle(false));
    } else {
      // touch: tap anywhere flips — but ignore taps that were really a swipe
      let x = 0,
        y = 0,
        drag = false;
      card.addEventListener('pointerdown', (e) => {
        x = e.clientX;
        y = e.clientY;
        drag = false;
      });
      card.addEventListener(
        'pointermove',
        (e) => {
          if (Math.abs(e.clientX - x) > 12 || Math.abs(e.clientY - y) > 12) drag = true;
        },
        { passive: true },
      );
      card.addEventListener('pointerup', () => {
        if (!drag) toggle();
      });
    }

    // keyboard
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });
  });
</script>
