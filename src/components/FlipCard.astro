---
import { Image } from 'astro:assets';
import type { Category } from '../data/categories';

interface Props {
  category: Category;
  /** duplicated slides used only to fill the infinite loop */
  clone?: boolean;
}
const { category, clone = false } = Astro.props;
---

<article class="card" style={`--accent:${category.accent}`} aria-hidden={clone ? 'true' : undefined}>
  <div class="inner">
    <div class="face front">
      <Image
        class="photo"
        src={category.image}
        alt={clone ? '' : category.name}
        widths={[345, 520, 690, 900]}
        sizes="(max-width: 640px) 80vw, 345px"
        loading="lazy"
      />
      <div class="front-body">
        <span class="icon" set:html={category.icon} />
        <h3>{category.frontTitle}</h3>
        <p>{category.frontText}</p>
      </div>
      <button class="flip-btn" type="button" aria-pressed="false" aria-label={`Ver detalle de ${category.name}`} tabindex={clone ? -1 : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
      </button>
    </div>

    <div class="face back">
      <span class="tag">{category.name}</span>
      <h4>{category.backTitle}</h4>
      <p>{category.backText}</p>
      <button class="flip-btn back-btn" type="button" aria-label="Volver" tabindex={clone ? -1 : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>
</article>

<style>
  .card {
    flex: 0 0 auto;
    width: min(80vw, 345px);
    aspect-ratio: 345 / 292;
    perspective: 1200px;
  }

  .inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.55s var(--ease);
    transform-style: preserve-3d;
  }
  .card.is-flipped .inner {
    transform: rotateY(180deg);
  }
  /* laptop / mouse: flip on hover */
  @media (hover: hover) and (pointer: fine) {
    .card:not(.is-flipped):hover .inner {
      transform: rotateY(180deg);
    }
    /* the +/- button is only needed for keyboard users here */
    .flip-btn {
      opacity: 0;
    }
    .card:focus-within .flip-btn {
      opacity: 1;
    }
  }

  .face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  /* only the face pointing at the viewer is interactive */
  .card:not(.is-flipped) .back {
    pointer-events: none;
  }
  .card.is-flipped .front {
    pointer-events: none;
  }

  /* front */
  .front {
    background: var(--c-black);
  }
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .front::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grad-card-front);
  }
  .front-body {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 0.95rem 1rem;
    color: var(--c-white);
  }
  .icon {
    width: 30px;
    height: 30px;
    margin-bottom: 0.15rem;
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .front-body h3 {
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .front-body p {
    font-size: 0.625rem;
    font-weight: 300;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.82);
  }

  /* back */
  .back {
    transform: rotateY(180deg);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.1rem 1.15rem 1.15rem;
    background: var(--c-black);
    color: var(--c-white);
    border-top: 3px solid var(--accent);
  }
  .tag {
    align-self: flex-start;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .back h4 {
    font-size: 0.9375rem;
    line-height: 1.25;
  }
  .back p {
    font-size: 0.75rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
    overflow-y: auto;
    padding-right: 0.15rem;
  }
  .back p::-webkit-scrollbar {
    width: 3px;
  }
  .back p::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.25);
    border-radius: 3px;
  }

  /* flip control */
  .flip-btn {
    position: absolute;
    right: 0.6rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 30px;
    aspect-ratio: 1;
    color: var(--c-white);
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    cursor: pointer;
    backdrop-filter: blur(3px);
    transition: background 0.15s var(--ease), transform 0.15s var(--ease), opacity 0.15s var(--ease);
  }
  .flip-btn:hover {
    background: var(--c-blue);
    transform: scale(1.1);
  }
  .flip-btn svg {
    width: 14px;
  }
  .front .flip-btn {
    top: 0.6rem;
  }
  .back .flip-btn {
    bottom: 0.6rem;
  }
</style>

<script>
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;

  document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
    const setFlip = (state: boolean) => {
      card.classList.toggle('is-flipped', state);
      card.querySelector('.front .flip-btn')?.setAttribute('aria-pressed', String(state));
    };

    // buttons (keyboard + explicit taps)
    card.querySelectorAll<HTMLButtonElement>('.flip-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        setFlip(!card.classList.contains('is-flipped'));
      });
    });

    if (canHover) {
      // desktop: hover drives it; clear any manual flip on leave so hover stays authoritative
      card.addEventListener('mouseleave', () => setFlip(false));
    } else {
      // touch: tap anywhere on the card toggles (ignore taps that are part of a swipe)
      let x = 0,
        y = 0,
        moved = false;
      card.addEventListener('pointerdown', (e) => {
        x = e.clientX;
        y = e.clientY;
        moved = false;
      });
      card.addEventListener('pointermove', (e) => {
        if (Math.abs(e.clientX - x) > 10 || Math.abs(e.clientY - y) > 10) moved = true;
      });
      card.addEventListener('pointerup', (e) => {
        if (moved || (e.target as HTMLElement).closest('.flip-btn')) return;
        setFlip(!card.classList.contains('is-flipped'));
      });
    }
  });
</script>
