---
import { Image } from 'astro:assets';
import type { Category } from '../data/categories';

interface Props {
  category: Category;
  /** duplicated slides used only to fill the infinite loop */
  clone?: boolean;
}
const { category, clone = false } = Astro.props;
---

<article
  class="card"
  style={`--accent:${category.accent}`}
  aria-hidden={clone ? 'true' : undefined}
  tabindex={clone ? undefined : '0'}
  aria-label={clone ? undefined : `${category.name} — pulsa para ver el detalle`}
>
  <div class="inner">
    <div class="face front">
      <Image
        class="photo"
        src={category.image}
        alt={clone ? '' : category.name}
        widths={[345, 520, 690, 900]}
        sizes="(max-width: 640px) 80vw, 345px"
        loading="lazy"
      />
      <div class="front-body">
        <span class="icon" set:html={category.icon} />
        <h3>{category.frontTitle}</h3>
        <p>{category.frontText}</p>
      </div>
    </div>

    <div class="face back">
      <span class="tag">{category.name}</span>
      <h4>{category.backTitle}</h4>
      <p>{category.backText}</p>
    </div>
  </div>
</article>

<style>
  .card {
    flex: 0 0 auto;
    width: min(80vw, 345px);
    aspect-ratio: 345 / 292;
    perspective: 1200px;
    cursor: pointer;
    border-radius: var(--radius-card);
  }
  .card:focus-visible {
    outline: 2px solid var(--c-blue-100);
    outline-offset: 4px;
  }

  .inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.55s var(--ease);
    transform-style: preserve-3d;
  }
  .card.is-flipped .inner {
    transform: rotateY(180deg);
  }
  /* laptop / mouse: flip on hover */
  @media (hover: hover) and (pointer: fine) {
    .card:not(.is-flipped):hover .inner {
      transform: rotateY(180deg);
    }
  }

  .face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  /* front */
  .front {
    background: var(--c-black);
  }
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .front::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grad-card-front);
  }
  .front-body {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 0.95rem 1rem;
    color: var(--c-white);
  }
  .icon {
    width: 30px;
    height: 30px;
    margin-bottom: 0.15rem;
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .front-body h3 {
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .front-body p {
    font-size: 0.625rem;
    font-weight: 300;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.82);
  }

  /* back */
  .back {
    transform: rotateY(180deg);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.1rem 1.15rem 1.15rem;
    background: var(--c-black);
    color: var(--c-white);
    border-top: 3px solid var(--accent);
  }
  .tag {
    align-self: flex-start;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .back h4 {
    font-size: 0.9375rem;
    line-height: 1.25;
  }
  .back p {
    font-size: 0.75rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
    overflow-y: auto;
    padding-right: 0.15rem;
  }
  .back p::-webkit-scrollbar {
    width: 3px;
  }
  .back p::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.25);
    border-radius: 3px;
  }
</style>

<script>
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;

  document.querySelectorAll<HTMLElement>('.card:not([aria-hidden])').forEach((card) => {
    const toggle = (state?: boolean) => {
      const next = state ?? !card.classList.contains('is-flipped');
      card.classList.toggle('is-flipped', next);
    };

    if (canHover) {
      // desktop: hover handles it; clear any lingering flip on leave
      card.addEventListener('mouseleave', () => toggle(false));
    } else {
      // touch: tap anywhere flips — but ignore taps that were really a swipe
      let x = 0,
        y = 0,
        drag = false;
      card.addEventListener('pointerdown', (e) => {
        x = e.clientX;
        y = e.clientY;
        drag = false;
      });
      card.addEventListener(
        'pointermove',
        (e) => {
          if (Math.abs(e.clientX - x) > 12 || Math.abs(e.clientY - y) > 12) drag = true;
        },
        { passive: true },
      );
      card.addEventListener('pointerup', () => {
        if (!drag) toggle();
      });
    }

    // keyboard
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });
  });
</script>
