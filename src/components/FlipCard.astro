---
import { Image } from 'astro:assets';
import type { Category } from '../data/categories';

interface Props {
  category: Category;
  /** duplicated slides that fill the infinite loop (not exposed to a11y) */
  clone?: boolean;
}
const { category, clone = false } = Astro.props;
---

<article
  class="card"
  data-cat={category.id}
  style={`--accent:${category.accent}`}
  aria-hidden={clone ? 'true' : undefined}
  tabindex={clone ? undefined : '0'}
  aria-label={clone ? undefined : `${category.name} — pulsa para ver el detalle`}
>
  <div class="inner">
    <div class="face front">
      <Image
        class="photo"
        src={category.image}
        alt={clone ? '' : category.name}
        widths={[345, 520, 690, 900]}
        sizes="(max-width: 640px) 80vw, 345px"
        loading="lazy"
      />
      <div class="front-body">
        <span class="icon" set:html={category.icon} />
        <h3>{category.frontTitle}</h3>
        <p>{category.frontText}</p>
      </div>
    </div>

    <div class="face back">
      <Image class="back-logo" src={category.backLogo} alt={clone ? '' : category.backTitle} height={46} densities={[1, 2]} format="png" loading="lazy" decoding="async" />
      <div class="back-desc"><p>{category.backText}</p></div>
      <ul class="back-benefits" aria-hidden="true">
        {category.backBenefits.map((b) => (
          <li><Image src={b} alt="" height={24} densities={[1, 2]} loading="lazy" decoding="async" /></li>
        ))}
      </ul>
    </div>
  </div>
</article>

<style>
  .card {
    flex: 0 0 auto;
    width: min(82vw, 350px);
    aspect-ratio: 340 / 278;
    perspective: 2000px;
    cursor: pointer;
    border-radius: var(--radius-card);
  }
  @media (max-width: 640px) {
    .card {
      aspect-ratio: 320 / 256;
    }
  }
  .card:focus-visible {
    outline: 2px solid var(--c-blue-100);
    outline-offset: 4px;
  }

  .inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.75s cubic-bezier(0.65, 0, 0.35, 1);
    transform-style: preserve-3d;
    will-change: transform;
  }
  .card.is-flipped .inner {
    transform: rotateY(180deg);
  }
  @media (hover: hover) and (pointer: fine) {
    .card:not(.is-flipped):hover .inner {
      transform: rotateY(180deg);
    }
  }

  .face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    /* fallback for browsers where backface-visibility is unreliable: hide the
       away-facing side, switched at the mid-point of the flip */
    transition: visibility 0s linear 0.375s;
  }
  .card:not(.is-flipped) .back {
    visibility: hidden;
  }
  .card.is-flipped .front {
    visibility: hidden;
  }
  @media (hover: hover) and (pointer: fine) {
    .card:not(.is-flipped):hover .front {
      visibility: hidden;
    }
    .card:not(.is-flipped):hover .back {
      visibility: visible;
    }
  }

  /* front */
  .front {
    background: var(--c-black);
  }
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .front::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grad-card-front);
  }
  .front-body {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 0.95rem 1rem;
    color: var(--c-white);
  }
  .icon {
    width: 30px;
    height: 30px;
    margin-bottom: 0.15rem;
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .front-body h3 {
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .front-body p {
    font-size: 0.625rem;
    font-weight: 300;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.82);
  }

  /* back — rebuilt in HTML at the proportions of the Figma art, but sharp */
  .back {
    transform: rotateY(180deg);
    display: grid;
    grid-template-rows: repeat(3, auto);
    align-content: safe center;
    justify-items: center;
    gap: clamp(0.55rem, 2.4vw, 0.9rem);
    padding: clamp(0.7rem, 3.5vw, 1rem);
    background: radial-gradient(130% 85% at 50% -5%, #1d1e22 0%, #0b0b0c 72%);
    color: #fff;
    text-align: center;
  }
  /* Logos vary in construction (1-line wordmark vs 2-line stacked). Per-category
     heights so the visible text reads at a consistent size across all cards. */
  .back-logo {
    --logo-h: 1;
    height: calc(clamp(22px, 5.6vw, 26px) * var(--logo-h));
    width: auto;
    max-width: 78%;
    object-fit: contain;
  }
  [data-cat='tv'] .back-logo { --logo-h: 0.92; }
  [data-cat='aire'] .back-logo { --logo-h: 1; }
  [data-cat='cocina'] .back-logo,
  [data-cat='microondas'] .back-logo { --logo-h: 1.05; }
  [data-cat='lavadora'] .back-logo { --logo-h: 1.4; }
  [data-cat='pilas'] .back-logo { --logo-h: 1.5; }
  [data-cat='refrigeradora'] .back-logo { --logo-h: 1.6; }
  .back-desc {
    align-self: stretch;
    max-height: 9.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .back-desc p {
    font-size: clamp(0.5rem, 0.42rem + 0.35vw, 0.625rem);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.94);
    text-wrap: pretty;
  }
  .back-desc::-webkit-scrollbar {
    width: 2px;
  }
  .back-desc::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.22);
  }
  .back-benefits {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(0.4rem, 1.8vw, 0.65rem) clamp(0.55rem, 3.5vw, 1.15rem);
    width: 100%;
    list-style: none;
    margin: 0;
    padding: clamp(0.45rem, 2vw, 0.7rem) 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .back-benefits li {
    flex: 0 0 auto;
    max-width: 46%;
  }
  .back-benefits :global(img) {
    max-width: 100%;
    max-height: clamp(20px, 5.5vw, 26px);
    width: auto;
    height: auto;
    object-fit: contain;
  }
</style>

<script>
  // Once any touch happens we treat this as a touch device, even if it also reports
  // (hover: hover) — some Android browsers and 2-in-1s do.
  let touchUsed = false;
  addEventListener('touchstart', () => (touchUsed = true), { once: true, passive: true, capture: true });
  const mouseOnly = () => !touchUsed && matchMedia('(hover: hover) and (pointer: fine)').matches;

  document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
    const real = !card.hasAttribute('aria-hidden');
    let flippedAt = 0;
    const flip = () => {
      card.classList.toggle('is-flipped');
      flippedAt = Date.now();
    };

    // mouse on a hover device: CSS :hover drives the flip; reset when the pointer leaves
    card.addEventListener('mouseleave', () => card.classList.remove('is-flipped'));

    // --- touch: tap flips, swipe doesn't ---
    let tx = 0,
      ty = 0;
    card.addEventListener(
      'touchstart',
      (e) => {
        tx = e.touches[0].clientX;
        ty = e.touches[0].clientY;
      },
      { passive: true },
    );
    card.addEventListener(
      'touchend',
      (e) => {
        const t = e.changedTouches[0];
        if (Math.hypot(t.clientX - tx, t.clientY - ty) > 14) return; // was a swipe
        e.preventDefault(); // stop the browser synthesising a click
        flip();
      },
      { passive: false },
    );

    // --- click: mouse-less activation (keyboard AT, screen readers) + fallback ---
    card.addEventListener('click', () => {
      if (mouseOnly()) return; // desktop mouse → hover already handled it
      if (Date.now() - flippedAt < 500) return; // touchend already handled it
      flip();
    });

    if (real) {
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          flip();
        }
      });
    }
  });
</script>
