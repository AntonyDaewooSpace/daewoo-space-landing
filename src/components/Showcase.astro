---
import { Image, getImage } from 'astro:assets';
import desktop from '../assets/portada.png';
import mobileImg from '../assets/portada-mobile.png';

const mobile = await getImage({
  src: mobileImg,
  widths: [420, 640, 820],
  format: 'webp',
});
---

<section class="showcase" aria-label="Redefinimos la conectividad del hogar">
  <picture>
    <source
      media="(max-width: 640px)"
      srcset={mobile.srcSet.attribute}
      sizes="100vw"
      width={mobileImg.width}
      height={mobileImg.height}
    />
    <Image
      src={desktop}
      alt="Redefinimos la conectividad del hogar, porque la verdadera vanguardia evoluciona. Cocina, televisor, refrigeradora y lavadora Daewoo."
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      loading="lazy"
    />
  </picture>
</section>

<style>
  .showcase {
    background: #00081a;
  }
  .showcase picture,
  .showcase :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
