---
import { Image } from 'astro:assets';
import flags from '../assets/flags-pe-kr.png';
import bg from '../assets/tvs-bg.png';
// tech logos: use the raw PNGs (sharp-edged flat art — webp re-encoding softens them)
import googleTv from '../assets/tech/google-tv.png';
import dolby from '../assets/tech/dolby-atmos.png';
import cast from '../assets/tech/google-cast.png';
import heyGoogle from '../assets/tech/hey-google.png';
import hdmi from '../assets/tech/hdmi.png';
import hdr10 from '../assets/tech/hdr10.png';

const logos = [
  { img: dolby, alt: 'Dolby Vision · Atmos' },
  { img: cast, alt: 'Google Cast' },
  { img: heyGoogle, alt: 'Hey Google' },
  { img: hdmi, alt: 'HDMI 2.1 Gaming' },
  { img: hdr10, alt: 'HDR10+' },
];
---

<section class="tech" id="tv">
  <p class="warranty">
    <Image src={flags} alt="Perú · Corea" width={278} height={21} densities={[1, 2]} />
    <span>Garantía especial <strong>DAEWOO OFICIAL</strong></span>
  </p>

  <div class="tv">
    <Image
      class="tv-bg"
      src={bg}
      alt=""
      aria-hidden="true"
      widths={[768, 1280, 1920]}
      sizes="100vw"
    />
    <div class="tv-inner" data-reveal>
      <img class="gtv" src={googleTv.src} alt="Google TV" width={googleTv.width} height={googleTv.height} loading="lazy" decoding="async" />
      <ul class="logos">
        {logos.map((l) => (
          <li>
            <img src={l.img.src} alt={l.alt} width={l.img.width} height={l.img.height} loading="lazy" decoding="async" />
          </li>
        ))}
      </ul>
      <p>
        Descubre cómo los televisores con Google TV transforman tu forma de ver series, películas y
        más. Todo lo que amas, en un solo lugar.
      </p>
    </div>
  </div>
</section>

<style>
  .warranty {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.95rem 1rem;
    background: var(--c-blue);
    color: var(--c-white);
    font-size: clamp(0.875rem, 0.82rem + 0.35vw, 1.0625rem);
    font-weight: 500;
    text-align: center;
  }
  .warranty :global(img) {
    height: 20px;
    width: auto;
  }

  .tv {
    position: relative;
    isolation: isolate;
    background: var(--c-black);
    color: var(--c-white);
    overflow: hidden;
  }
  .tv-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.38;
    z-index: -1;
  }
  .tv::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.55) 45%, rgba(0, 0, 0, 0.2) 100%);
    z-index: -1;
  }

  .tv-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.15rem;
    width: fit-content;
    max-width: min(90vw, 620px);
    margin-left: max(var(--pad-x), calc((100vw - var(--container)) / 2));
    padding-block: clamp(3rem, 7vw, 4rem);
    padding-right: var(--pad-x);
  }
  /* Google TV centred over the logo row below it */
  .gtv {
    align-self: center;
    height: clamp(34px, 3.6vw, 46px);
    width: auto;
  }
  .logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.7rem 1.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .logos img {
    height: clamp(21px, 2vw, 26px);
    width: auto;
  }
  .tv-inner p {
    max-width: 52ch;
    font-size: var(--fs-body);
    color: var(--c-grey-light);
  }

  @media (max-width: 640px) {
    .tv-inner {
      align-items: center;
      text-align: center;
      margin-inline: auto;
    }
  }
</style>
