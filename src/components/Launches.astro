---
import { categories } from '../data/categories';
import FlipCard from './FlipCard.astro';

// render the set twice so the auto-scroll can loop seamlessly
const loop = [...categories, ...categories];
---

<section class="launches" id="lanzamientos">
  <div class="container head" data-reveal>
    <p class="eyebrow">Próximos lanzamientos</p>
    <h2>La ingeniería del futuro, muy pronto en tu hogar</h2>
  </div>

  <div class="carousel">
    <ul class="track">
      {loop.map((category, i) => (
        <li><FlipCard category={category} clone={i >= categories.length} /></li>
      ))}
    </ul>
  </div>

  <div class="controls container">
    <button class="arrow prev" type="button" aria-label="Categoría anterior">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <div class="dots" role="tablist" aria-label="Ir a categoría">
      {categories.map((c, i) => (
        <button
          class="dot"
          type="button"
          role="tab"
          data-index={i}
          aria-label={c.name}
          aria-selected={i === 0 ? 'true' : 'false'}
        ></button>
      ))}
    </div>

    <button class="arrow next" type="button" aria-label="Categoría siguiente">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.launches').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.track')!;
    const prev = root.querySelector<HTMLButtonElement>('.prev')!;
    const next = root.querySelector<HTMLButtonElement>('.next')!;
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.dot')];
    const real = dots.length; // 7
    const cards = [...track.querySelectorAll<HTMLElement>('li')];

    const stride = () => {
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return cards[0].getBoundingClientRect().width + gap;
    };
    const setWidth = () => stride() * real;

    // keep the scroll position inside the first copy of the set (clones are only a
    // buffer). Skipped while a smooth programmatic scroll is running so it can't jump.
    let animating = 0;
    const normalize = () => {
      const w = setWidth();
      if (track.scrollLeft >= w * 1.999) track.scrollLeft -= w;
      else if (track.scrollLeft < 0) track.scrollLeft += w;
      else if (!animating && Date.now() - lastUserScroll > 400 && track.scrollLeft >= w) {
        track.scrollLeft -= w;
      }
    };
    let lastUserScroll = 0;

    const syncDots = () => {
      const idx = Math.round(track.scrollLeft / stride()) % real;
      dots.forEach((d, i) => d.setAttribute('aria-selected', String(i === ((idx % real) + real) % real)));
    };

    const markAnimating = () => {
      animating++;
      window.setTimeout(() => (animating = Math.max(0, animating - 1)), 650);
    };

    const step = (dir: number) => {
      // wrap first (while at rest) so the smooth animation never crosses the seam
      if (dir > 0 && track.scrollLeft >= setWidth() - 1) track.scrollLeft -= setWidth();
      if (dir < 0 && track.scrollLeft <= 1) track.scrollLeft += setWidth();
      markAnimating();
      track.scrollBy({ left: dir * stride(), behavior: 'smooth' });
    };

    const goToDot = (i: number) => {
      const base = Math.round(track.scrollLeft / setWidth()) * setWidth();
      markAnimating();
      track.scrollTo({ left: base + stride() * i, behavior: 'smooth' });
    };

    // ---- autoplay ----
    let timer = 0;
    let hovering = false;
    const play = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => {
        if (!hovering && !document.hidden) step(1);
      }, 3200);
    };
    const bumpPlay = () => {
      window.clearInterval(timer);
      window.setTimeout(play, 4000);
    };

    prev.addEventListener('click', () => { step(-1); bumpPlay(); });
    next.addEventListener('click', () => { step(1); bumpPlay(); });
    dots.forEach((d, i) => d.addEventListener('click', () => { goToDot(i); bumpPlay(); }));

    track.addEventListener('pointerenter', () => { hovering = true; });
    track.addEventListener('pointerleave', () => { hovering = false; });
    track.addEventListener('scroll', () => { normalize(); syncDots(); }, { passive: true });
    track.addEventListener('wheel', () => { lastUserScroll = Date.now(); }, { passive: true });
    track.addEventListener('touchstart', () => { hovering = true; lastUserScroll = Date.now(); }, { passive: true });
    track.addEventListener('touchmove', () => { lastUserScroll = Date.now(); }, { passive: true });
    track.addEventListener('touchend', () => { hovering = false; bumpPlay(); });

    // start aligned to the first card, then run
    requestAnimationFrame(() => {
      track.scrollLeft = 0;
      syncDots();
      play();
    });
  });
</script>

<style>
  .launches {
    /* first card lines up with the heading text */
    --gutter: max(var(--pad-x), calc((100vw - var(--container)) / 2 + var(--pad-x)));
    background: var(--c-white);
    padding-block: var(--section-y);
    overflow: clip;
  }
  .head {
    margin-bottom: 2rem;
  }
  .head h2 {
    font-size: var(--fs-h2);
    color: var(--c-ink);
    margin-top: 0.35rem;
  }

  .carousel {
    position: relative;
  }
  /* soft edge fades so cards slide out of view instead of being hard-clipped */
  .carousel::before,
  .carousel::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 3;
    width: clamp(1rem, 4vw, 3.5rem);
    pointer-events: none;
  }
  .carousel::before {
    left: 0;
    background: linear-gradient(90deg, var(--c-white), transparent);
  }
  .carousel::after {
    right: 0;
    background: linear-gradient(270deg, var(--c-white), transparent);
  }

  .track {
    display: flex;
    gap: clamp(0.9rem, 1.8vw, 1.35rem);
    list-style: none;
    margin: 0;
    padding: 1rem var(--pad-x) 1.5rem var(--gutter);
    scroll-padding-left: var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track > li {
    display: flex;
    scroll-snap-align: start;
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.75rem;
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 42px;
    aspect-ratio: 1;
    color: var(--c-ink);
    background: var(--c-white);
    border: 1px solid rgba(0, 0, 0, 0.14);
    border-radius: 50%;
    box-shadow: 0 6px 16px -8px rgba(0, 0, 0, 0.3);
    cursor: pointer;
    transition: transform 0.15s var(--ease), color 0.15s var(--ease), border-color 0.15s var(--ease);
  }
  .arrow:hover {
    color: var(--c-blue);
    border-color: var(--c-blue);
    transform: scale(1.06);
  }
  .arrow svg {
    width: 20px;
  }

  .dots {
    display: flex;
    gap: 0.15rem;
  }
  .dot {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .dot::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c-grey);
    transition: background 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .dot[aria-selected='true']::before {
    background: var(--c-blue);
    transform: scale(1.2);
  }

  @media (max-width: 560px) {
    .arrow {
      display: none;
    }
  }
</style>
