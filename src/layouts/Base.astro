---
import '../styles/global.css';
import { site } from '../data/site';
import { withBase } from '../lib/url';
import figtreeFont from '../assets/fonts/figtree-latin.woff2';
import ogImage from '../assets/portada.png';
import { getImage } from 'astro:assets';

const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' });

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Daewoo Perú — 50 años conectados a tu vida',
  description = site.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://antonydaewoospace.github.io');
const ogUrl = new URL(og.src, canonical);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Daewoo Perú',
  url: canonical.origin + withBase(''),
  logo: new URL(withBase('favicon.svg'), canonical).href,
  description: site.description,
  sameAs: [
    'https://www.instagram.com/daewoo.pe/',
    'https://www.facebook.com/daewoo.pe',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+51-800-0071019',
    contactType: 'customer service',
    email: site.email,
    areaServed: 'PE',
    availableLanguage: 'Spanish',
  },
};
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0062ae" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Daewoo Perú" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />

    <link rel="preload" href={figtreeFont} as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#inicio">Saltar al contenido</a>
    <slot />

    <script>
      // Reveal-on-scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>

    <style>
      .skip-link {
        position: fixed;
        top: 0.5rem;
        left: 0.5rem;
        z-index: 200;
        padding: 0.6rem 1rem;
        background: var(--c-white);
        color: var(--c-blue);
        font-weight: 700;
        border-radius: 8px;
        transform: translateY(-150%);
        transition: transform 0.2s var(--ease);
      }
      .skip-link:focus-visible { transform: none; }
    </style>
  </body>
</html>
